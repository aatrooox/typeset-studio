{
  "name": "@akairos/typeset-studio",
  "version": "0.2.2",
  "description": "Algorithmic typesetting studio & zzhub-pipeline image renderer plugin",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aatrooox/typeset-studio.git"
  },
  "homepage": "https://github.com/aatrooox/typeset-studio#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapter": {
      "import": "./dist/lib/adapter.js",
      "types": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    }
  },
  "files": [
    "dist/assets",
    "dist/index.html",
    "dist/lib",
    "src",
    "data/templates",
    "public/fonts/README.md",
    "public/fonts/fonts.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:all": "bun --watch src/server/index.ts & vite",
    "build": "vite build && bun run build:lib",
    "build:lib": "bun build src/index.ts src/adapter.ts --outdir dist/lib --target node --external @napi-rs/canvas",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "server": "bun run src/server/index.ts",
    "server:watch": "bun --watch src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@napi-rs/canvas": "^1.0.10",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
