{
  "name": "@akairos/typeset-studio",
  "version": "0.4.1",
  "description": "Algorithmic typesetting studio & zzhub-pipeline image renderer plugin",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k7airos/typeset-studio.git"
  },
  "homepage": "https://github.com/k7airos/typeset-studio#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./server-config": {
      "types": "./src/server-config.ts",
      "import": "./dist/lib/server-config.js"
    },
    "./cover": {
      "types": "./src/cover.ts",
      "import": "./dist/cover/cover.js"
    },
    "./editor": {
      "types": "./src/web/editor.ts",
      "import": "./dist/editor/editor.js"
    },
    "./server-font": {
      "types": "./src/server-font.ts",
      "import": "./dist/lib/server-font.js"
    },
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapter": {
      "import": "./dist/lib/adapter.js",
      "types": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    }
  },
  "files": [
    "dist/assets",
    "dist/index.html",
    "dist/lib",
    "dist/editor",
    "dist/cover",
    "src",
    "public/fonts/README.md",
    "public/fonts/fonts.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:all": "bun --watch src/server/index.ts & vite",
    "build": "vite build && bun run build:lib",
    "build:lib": "bun run build:editor-css && rm -rf dist/lib dist/editor dist/cover && bun build src/index.ts src/adapter.ts src/server-font.ts src/server-config.ts --outdir dist/lib --target node --splitting --external @napi-rs/canvas && bun build src/cover.ts --outdir dist/cover --target browser && bun build src/web/editor.ts --outdir dist/editor --target browser --production --external react --external react/jsx-runtime --external react/jsx-dev-runtime --external react-dom",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "server": "bun run src/server/index.ts",
    "server:watch": "bun --watch src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "build:editor-css": "bun x tailwindcss -c tailwind.editor.config.js -i src/web/editor-tailwind.css -o /tmp/typeset-editor-utilities.css --minify && cat /tmp/typeset-editor-utilities.css src/web/editor-base.css > src/web/editor.css"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@napi-rs/canvas": "^1.0.10",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
